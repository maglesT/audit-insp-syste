  {
   "id": "CMP-002",
   "topic": "CMP.RECALL",
   "item_text": "Besides recall, other actions to reduce the risk from quality defects may be considered, such as warning healthcare professionals about the use of a batch that may be defective.",
   "strength": "optional",
   "plant_types": [
    "INJ",
    "LIQ",
    "OSD",
    "SEMI"
   ],
   "parameters": {},
   "general": false,
   "status": "draft",
   "mappings": [
    {
     "source": "pics-pe009-18-part1.pdf",
     "clause_ref": "Part I 8.31",
     "clause_sha256": "8dae8d2f9b5960700782ae678db08aefba519259d003b7ab5f9b778129e13c5d",
     "quote": "In addition to recalls, there are other potential risk-reducing actions that may be considered in order to manage the risks presented by quality defects. Such actions may include the issuance of cautionary communications to healthcare professionals in relation to their use of a batch that is potentially defective.",
     "strength": "optional",
     "relation": "same",
     "plant_types": [
      "OSD",
      "LIQ",
      "SEMI",
      "INJ"
     ],
     "addendum": ""
    }
   ]
  },
  {
